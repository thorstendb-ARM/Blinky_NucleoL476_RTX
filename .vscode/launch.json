{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with ST-Link",
            "cwd": "${workspaceFolder}",
            "executable": "./out/Blinky/NUCLEO-L476RG/Debug/Blinky.axf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink"
        },
        {
            "name": "STLink@pyOCD (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/Blinky/NUCLEO-L476RG/Debug/Blinky.axf",
            "gdb": "arm-none-eabi-gdb",
            "initCommands": [
                "load out/Blinky/NUCLEO-L476RG/Debug/Blinky.hex",
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "--probe",
                    "stlink:",
                    "--connect",
                    "attach"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}"
            }
        },
        {
            "name": "STLink@pyOCD (prog)",
            "type": "gdbtarget",
            "request": "launch",
            //"debugServer": 4711,
            "cwd": "${workspaceFolder}/",
            "program": "out/Blinky/NUCLEO-L476RG/Debug/Blinky.axf",
            "gdb": "arm-none-eabi-gdb",
            "initCommands": [
                "load out/Blinky/NUCLEO-L476RG/Debug/Blinky.hex",
                "monitor reset halt",
                "tbreak main"
            ],
            "customResetCommands": [
                "monitor reset halt"
            ],
            "target": {
                "server": "pyocd",
                "serverParameters": [
                    "--probe",
                    "stlink:",
                    "--connect",
                    "attach"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}"
            }
        }

    ]
}